  }, {
    "expression" : "writeResult.getWriteStatuses().stream().allMatch(ws -> ws != null)",
    "rationale" : "All WriteStatus entries should be valid.",
    "meta" : [ ]
  }, {
    "expression" : "writeResult.getWriteStatuses().stream().allMatch(ws -> ws.getStat() != null)",
