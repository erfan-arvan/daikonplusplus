      "value" : "boolean"
    } ]
  }, {
    "expression" : "autoDetectAndDeleteMetadataPartitions == true || autoDetectAndDeleteMetadataPartitions == false",
    "rationale" : "Boolean parameters should always be true or false.",
    "meta" : [ {
      "key" : "type",
      "value" : "boolean"
    } ]
  }, {
    "expression" : "!triggeringInstantTimestamp.isEmpty()",
