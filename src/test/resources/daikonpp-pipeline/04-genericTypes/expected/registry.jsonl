{"id":"046dd415-a385-4eef-934c-9c35bf8551a4","expr":"args == null || args.length >= 0","rationale":"Ensures no NullPointerException on args length access if null.","kind":"METHOD_ENTRY","element":"com.example.Main#main(String[]):void","file":"com/example/Main.java","createdAt":"2026-01-08T03:46:33.716827Z"}
